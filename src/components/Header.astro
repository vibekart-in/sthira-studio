---
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { label: 'Projects', href: `${base}projects/`, key: '/projects' },
  { label: 'Services', href: `${base}services/`, key: '/services' },
  { label: 'Studio', href: `${base}studio/`, key: '/studio' },
  { label: 'Contact', href: `${base}contact/`, key: '/contact' }
];
---
<div class="topline">
  <p>Architecture · Interiors · Spatial design</p>
  <p>Jaipur, India <span class="topline-dot">—</span> Working everywhere</p>
</div>
<header class="site-header" data-header>
  <a class="wordmark" href={base} aria-label="Sthira Studio home">
    <span class="wordmark-symbol">S<span>.</span></span>
    <span class="wordmark-name">STHIRA <small>STUDIO</small></span>
  </a>
  <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle>
    <span></span><span></span>
  </button>
  <nav class="primary-nav" id="primary-navigation" aria-label="Primary navigation" data-navigation>
    {nav.map((item) => (
      <a href={item.href} class:list={[{ active: currentPath.startsWith(item.key) }]}>{item.label}</a>
    ))}
    <a class="nav-enquire" href={`${base}contact/`}>Start a conversation <span aria-hidden="true">↗</span></a>
  </nav>
</header>
