---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionIntro from '../components/SectionIntro.astro';
import { projects } from '../data/projects';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Sthira Studio — A quieter kind of architecture" description="Architecture and interiors shaped by place, light and the rituals of everyday life.">
  <section class="home-hero" id="top">
    <div class="hero-copy">
      <div class="eyebrow hero-kicker"><span class="eyebrow-line"></span> Independent architecture / Jaipur + everywhere</div>
      <h1>FORM<br /><span class="hero-outline">FOLLOWS</span><br /><em>FEELING<span class="hero-period">.</span></em></h1>
      <p class="hero-description">We design places that move with the people inside them. Architecture, interiors and spatial ideas with clarity, character and a little curiosity.</p>
      <div class="hero-actions"><a class="button button-dark" href={`${base}projects/`}>Explore selected work <span>↗</span></a><a class="text-link" href={`${base}studio/`}>Inside the studio <span>↗</span></a></div>
      <div class="hero-meta"><span>01 / 04</span><i></i><span>People&nbsp; · &nbsp;Place&nbsp; · &nbsp;Possibility</span></div>
    </div>
    <div class="hero-visual" aria-label="Interactive three-dimensional architectural concept model">
      <div class="hero-visual-glow"></div>
      <canvas id="architecture-canvas" aria-label="A slowly rotating three-dimensional architectural maquette. Move your pointer to explore its perspective." role="img"></canvas>
      <div class="hero-visual-grid" aria-hidden="true"></div>
      <div class="hero-model-label"><span class="model-label-dot"></span><span>SPATIAL STUDY / 001</span><strong>Courtyard house<br />— Jaipur, IN</strong></div>
      <div class="hero-coordinate">26°54' N<br />75°47' E</div>
      <div class="hero-orbit-label">MODEL VIEW / 360°</div>
    </div>
    <a class="hero-scroll-cue" href="#manifesto"><span>Scroll to explore</span><i></i></a>
    <div class="hero-side-note">STHIRA <span>ARCHITECTURE / INTERIORS</span></div>
  </section>

  <div class="ticker-band" aria-label="Studio principles"><div class="ticker-track"><span>Architecture with intent</span><i>✳</i><span>Interiors with feeling</span><i>✳</i><span>Materials with meaning</span><i>✳</i><span>Spaces that endure</span><i>✳</i><span>Architecture with intent</span><i>✳</i><span>Interiors with feeling</span><i>✳</i></div></div>

  <section class="manifesto-section section-pad" id="manifesto" data-reveal>
    <div class="manifesto-mark">S<span>.</span></div>
    <div class="manifesto-content"><div class="section-index"><span>01</span><i></i><span>A way of seeing</span></div><h2>Good spaces don't ask for attention.<br /><em>They earn a place in your life.</em></h2><div class="manifesto-bottom"><p>We believe architecture is more than the arrangement of walls and rooms. It is the feeling of arriving, the quality of the light at a certain hour, and the details that quietly make a place your own.</p><a class="text-link" href={`${base}studio/`}>Get to know the studio <span>↗</span></a></div></div>
  </section>

  <section class="work-section section-pad" data-reveal>
    <SectionIntro index="02" eyebrow="Selected explorations" title="Spaces with a <em>sense of place.</em>" text="A collection of residential and interior concepts exploring proportion, texture and the relationship between built space and its surroundings." />
    <div class="project-grid home-project-grid">
      {projects.slice(0, 3).map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
    </div>
    <div class="section-end-link"><span>01 — 03 / SELECTED STUDIES</span><a class="button button-outline" href={`${base}projects/`}>View all explorations <span>↗</span></a></div>
  </section>

  <section class="interlude-image">
    <img src="https://images.unsplash.com/photo-1754613389158-3b13a051a81a?auto=format&fit=crop&w=2200&q=85" alt="Soft natural light entering a calm and carefully composed living interior" loading="lazy" />
    <div class="interlude-overlay"><span>LIGHT / MATERIAL / MOMENT</span><p>“A place should feel<br /><em>like it could only be here.</em>”</p></div>
  </section>

  <section class="approach-section section-pad" data-reveal>
    <SectionIntro index="03" eyebrow="How we work" title="A thoughtful process.<br /><em>From first thought to final detail.</em>" text="Each project begins with listening. We take time to understand the people, place and possibilities before deciding what a space should become." />
    <div class="process-grid">
      <article class="process-step"><span>01 / Listen</span><div class="process-symbol">◎</div><h3>Understand the brief</h3><p>We begin with conversations, context and careful questions. The best solutions come from understanding what matters most.</p></article>
      <article class="process-step"><span>02 / Imagine</span><div class="process-symbol">⌁</div><h3>Find the direction</h3><p>Ideas take shape through spatial studies, material explorations and a clear design language.</p></article>
      <article class="process-step"><span>03 / Resolve</span><div class="process-symbol">⌗</div><h3>Work through detail</h3><p>Proportion, light, finish and function are brought together into a coherent whole.</p></article>
      <article class="process-step"><span>04 / Realise</span><div class="process-symbol">↗</div><h3>Bring it to life</h3><p>We value thoughtful coordination and considered execution, right down to the final touch.</p></article>
    </div>
  </section>

  <section class="services-preview section-pad" data-reveal>
    <div class="services-preview-left"><div class="section-index section-index-light"><span>04</span><i></i><span>What we do</span></div><h2>One connected view<br />of <em>space.</em></h2><p>From the first line of a building to the last considered detail of an interior, we look at the whole experience.</p><a class="button button-light" href={`${base}services/`}>Explore our services <span>↗</span></a></div>
    <div class="services-preview-list"><a href={`${base}services/#architecture`}><span>01</span><strong>Architecture</strong><i>↗</i></a><a href={`${base}services/#interiors`}><span>02</span><strong>Interior design</strong><i>↗</i></a><a href={`${base}services/#renovation`}><span>03</span><strong>Renovation & renewal</strong><i>↗</i></a><a href={`${base}services/#spatial`}><span>04</span><strong>Spatial & styling direction</strong><i>↗</i></a></div>
  </section>

  <section class="home-contact section-pad" data-reveal><div class="section-index"><span>05</span><i></i><span>Begin somewhere</span></div><div class="home-contact-main"><h2>Have a place<br />in <em>mind?</em></h2><div><p>Every meaningful space begins with a conversation. Tell us a little about what you're imagining.</p><a class="button button-dark" href={`${base}contact/`}>Start a conversation <span>↗</span></a></div></div></section>
  <script>
    import '../scripts/architecture-scene.js';
  </script>
</BaseLayout>
