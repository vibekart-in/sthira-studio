---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import type { Project } from '../../data/projects';
export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props as { project: Project };
const base = import.meta.env.BASE_URL;
const asset = (src: string) => `${base}${src.replace(/^\/+/, '')}`;
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length];
---
<BaseLayout title={`${project.title} â€” Sthira Studio`} description={project.intro} image={asset(project.cover)}>
  <section class="project-detail-hero">
    <div class="project-detail-heading" data-reveal>
      <div class="section-index"><span>{project.number}</span><i></i><span>{project.status}</span></div>
      <h1>{project.title}<br /><em>{project.subtitle}</em></h1>
      <p>{project.intro}</p>
    </div>
    <figure class="project-detail-cover" data-reveal>
      <img src={asset(project.cover)} alt={project.coverAlt} fetchpriority="high" decoding="async" />
      <figcaption class="project-cover-credit">
        <span>VISUAL REFERENCE / {project.year}</span>
        <a href={project.coverSource} target="_blank" rel="noopener noreferrer">Photograph by {project.coverCredit} â†—</a>
      </figcaption>
    </figure>
  </section>

  <section class="project-facts section-pad" aria-label="Project information" data-reveal>
    <div><span>Location</span><strong>{project.location}</strong></div>
    <div><span>Discipline</span><strong>{project.category}</strong></div>
    <div><span>Design focus</span><strong>{project.focus}</strong></div>
    <div><span>Project type</span><strong>Concept study</strong></div>
  </section>

  <section class="project-story section-pad" data-reveal>
    <div class="project-story-title">
      <span>DESIGN INTENT / {project.number}</span>
      <h2>A considered response<br />to <em>its surroundings.</em></h2>
    </div>
    <div class="project-story-copy">
      <p class="project-story-lead">{project.intro}</p>
      <p>{project.concept}</p>
      <div class="material-list">
        <span>Material direction</span>
        {project.materials.map((material) => <i>{material}</i>)}
      </div>
    </div>
  </section>

  <section class="project-gallery section-pad" data-reveal>
    <div class="project-gallery-heading">
      <div>
        <div class="section-index"><span>02</span><i></i><span>Spatial impressions</span></div>
        <h2>Light, texture<br />and <em>form.</em></h2>
      </div>
      <p>A visual reference for the atmosphere and material language explored in this concept study.</p>
    </div>
    <div class="project-gallery-grid">
      {project.gallery.map((image, index) => (
        <figure class:list={[index === 0 ? 'gallery-primary' : 'gallery-secondary']}>
          <div class="project-gallery-image"><img src={asset(image.src)} alt={image.alt} loading="lazy" decoding="async" /></div>
          <figcaption>
            <span class="gallery-number">0{index + 1}</span>
            <strong>{image.caption}</strong>
            <a href={image.source} target="_blank" rel="noopener noreferrer">Photo: {image.credit} â†—</a>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="next-project section-pad" data-reveal>
    <div class="next-project-copy">
      <span>CONTINUE EXPLORING / {nextProject.number}</span>
      <h2>{nextProject.title}</h2>
      <p>{nextProject.subtitle}</p>
    </div>
    <a class="next-project-preview" href={`${base}projects/${nextProject.slug}/`} aria-label={`Explore ${nextProject.title}`}>
      <img src={asset(nextProject.cover)} alt="" loading="lazy" />
      <span>Explore next study <b>â†—</b></span>
    </a>
  </section>

  <div class="project-detail-back"><a class="text-link" href={`${base}projects/`}>â† Back to all explorations</a></div>
  <div class="concept-note">
    <span>PORTFOLIO NOTE</span>
    <p>All STHIRA projects shown here are fictional concept studies, not completed client commissions. Photography is credited visual reference sourced from Pexels; it is not presented as photography of STHIRA-designed or built projects.</p>
  </div>
</BaseLayout>