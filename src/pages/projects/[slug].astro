---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length];
---
<BaseLayout title={`${project.title} — Sthira Studio`} description={project.intro} image={project.cover}>
  <section class="project-detail-hero">
    <div class="project-detail-heading"><div class="section-index"><span>{project.number}</span><i></i><span>{project.status}</span></div><h1>{project.title}<br /><em>{project.subtitle}</em></h1><p>{project.intro}</p></div>
    <div class="project-detail-cover"><img src={project.cover} alt={project.coverAlt} fetchpriority="high" /><span>CONCEPT STUDY / {project.year}</span></div>
  </section>
  <section class="project-facts section-pad"><div><span>Location</span><strong>{project.location}</strong></div><div><span>Discipline</span><strong>{project.category}</strong></div><div><span>Year</span><strong>{project.year}</strong></div><div><span>Scope</span><strong>{project.area}</strong></div></section>
  <section class="project-story section-pad"><div class="project-story-title"><span>THE IDEA / {project.number}</span><h2>A considered response<br />to <em>its surroundings.</em></h2></div><div class="project-story-copy"><p>{project.concept}</p><div class="material-list"><span>Material direction</span>{project.materials.map((material) => <i>{material}</i>)}</div></div></section>
  <section class="project-gallery section-pad"><div class="section-index"><span>02</span><i></i><span>Spatial impressions</span></div><div class="project-gallery-grid">{project.gallery.map((image, index) => <figure class:list={[{ 'gallery-wide': index === 0 }]}><img src={image.src} alt={image.alt} loading="lazy" /><figcaption><span>0{index + 1}</span>{image.caption}</figcaption></figure>)}</div></section>
  <section class="next-project"><div><span>Continue exploring</span><h2>{nextProject.title}</h2><p>{nextProject.subtitle}</p></div><a href={`${base}projects/${nextProject.slug}/`} aria-label={`View ${nextProject.title}`}>↗</a></section>
  <div class="project-detail-back"><a class="text-link" href={`${base}projects/`}>← Back to all explorations</a></div>
  <div class="concept-note"><span>PORTFOLIO NOTE</span><p>This page is an illustrative concept study. Imagery is used as visual reference; project details and design narratives are fictional and should not be read as a record of a completed commission.</p></div>
</BaseLayout>
