---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const services = [
  { id: 'architecture', no: '01', title: 'Architecture', sub: 'From first principles to the shape of a place.', desc: 'We explore how a building can respond to its site, climate and people. The work begins with context and develops through clear spatial thinking, proportion and material expression.', items: ['Residential architecture', 'New-build concept design', 'Spatial planning', 'Context and site studies'] },
  { id: 'interiors', no: '02', title: 'Interior design', sub: 'An atmosphere built through thoughtful detail.', desc: 'Interiors are considered as complete experiences. We bring light, circulation, material, furniture and function into one coherent language.', items: ['Residential interiors', 'Material and finish direction', 'Custom joinery concepts', 'Lighting and furniture direction'] },
  { id: 'renovation', no: '03', title: 'Renovation & renewal', sub: 'Finding a new life in what already exists.', desc: 'Existing spaces hold character and possibility. We look for ways to clarify, adapt and improve them without losing what makes them meaningful.', items: ['Interior refurbishment', 'Adaptive reuse concepts', 'Layout reconfiguration', 'Material refresh'] },
  { id: 'spatial', no: '04', title: 'Spatial & styling direction', sub: 'The finishing layer that makes a space feel complete.', desc: 'A final layer of decisions brings a space together. We study the relationship between objects, art, texture and the everyday rituals of a room.', items: ['Furniture and object curation', 'Art and styling direction', 'Spatial storytelling', 'Visual concept development'] }
];
---
<BaseLayout title="Services — Sthira Studio" description="Architecture, interiors, renovation and spatial direction — considered as one connected practice.">
  <section class="page-hero page-hero-compact"><div class="section-index"><span>02</span><i></i><span>What we do</span></div><h1>One practice.<br /><em>Many ways to shape space.</em></h1><p>We work across architecture and interiors, bringing a connected point of view to the places people inhabit.</p><div class="page-hero-side">THINK<br />MAKE<br />REFINE</div></section>
  <section class="services-list-section section-pad"><div class="services-list-intro"><span>OUR SERVICES / 01—04</span><p>Every brief is different. Our role is to find the right questions, bring clarity to the possibilities and shape a direction that feels true to the people and place.</p></div>
    {services.map((service) => <article class="service-row" id={service.id}><div class="service-row-number">{service.no}</div><div class="service-row-main"><h2>{service.title}</h2><p class="service-subtitle">{service.sub}</p><p class="service-desc">{service.desc}</p></div><ul>{service.items.map((item) => <li>{item}</li>)}</ul></article>)}
  </section>
  <section class="service-principle"><div class="principle-image"><img src="https://images.unsplash.com/photo-1585128792020-803d29415281?auto=format&fit=crop&w=1400&q=85" alt="Minimal interior with timber, natural material and daylight" loading="lazy" /></div><div class="principle-copy"><span>THE CONNECTED VIEW</span><h2>Inside and out.<br /><em>Never in isolation.</em></h2><p>We believe the strongest spaces come from seeing the whole picture: how the building meets the ground, how a room meets the light, and how the smallest detail contributes to the larger feeling.</p><a class="text-link" href={`${base}studio/`}>Read our approach <span>↗</span></a></div></section>
  <section class="project-bottom-cta"><span>Have a brief taking shape?</span><a href={`${base}contact/`}>Start with a conversation <b>↗</b></a></section>
</BaseLayout>
